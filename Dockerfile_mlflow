FROM python:3.9-slim-buster

WORKDIR /app

RUN pip install --no-cache-dir mlflow==2.10.1

RUN mkdir -p /mlruns /mlartifacts

EXPOSE 5000

CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--backend-store-uri", "sqlite:////mlruns/mlflow.db", "--default-artifact-root", "mlflow-artifacts:/", "--serve-artifacts", "--artifacts-destination", "/mlartifacts"]